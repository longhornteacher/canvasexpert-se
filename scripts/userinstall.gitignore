# Teacher and runtime data: never tracked, never touched by a pull.
/context/
/courses/
/Teacher_Override.md
/.cse/
/.claude/settings.local.json
/playbook-old/
/shipped/
/install-log.jsonl
*.cse.json

# The Engine is downloaded by get-engine.cmd; only its manifest, notices and shortcut icon are tracked.
/engine/*
!/engine/manifest.txt
!/engine/THIRD_PARTY_NOTICES.md
!/engine/canvasexpert.ico
